# Core
AUDIO_BACKEND=local
LOCAL_AUDIO_ROOT=app/storage/audio

# Model runtime
USE_REAL_MODELS=false
EN_YO_MODEL_ID=Helsinki-NLP/opus-mt-en-yo
YO_EN_MODEL_ID=Helsinki-NLP/opus-mt-yo-en
YORUBA_ASR_MODEL_ID=NCAIR1/Yoruba-ASR
NIGERIAN_ENGLISH_TTS_MODEL_ID=NCAIR1/NigerianAccentedEnglish
YORUBA_TTS_MODEL_ID=Workhelio/yoruba_tts

# Security / throttling
REQUIRE_API_KEY=false
API_KEY=
RATE_LIMIT_PER_MINUTE=60

# Job backend
USE_REDIS_JOBS=false
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO (used when AUDIO_BACKEND=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=false
S3_KEY_PREFIX=audio

# Supabase Storage (used when AUDIO_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=audio
SUPABASE_KEY_PREFIX=audio
